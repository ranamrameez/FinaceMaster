# Copy this file to keystore.properties (same directory, gitignored — never commit the
# real one) to build a locally-signed release APK/AAB with `./gradlew assembleRelease` /
# `./gradlew bundleRelease`.
#
# Without this file (and without the equivalent CI secrets, see
# .github/workflows/android-build.yml), the release build type simply builds unsigned —
# nothing breaks, you just get an APK/AAB you can't install as-is.
#
# storeFile is resolved relative to this file's own directory (android/), so if your
# keystore sits right next to this file, "financerecorder-release.jks" is enough; if it
# lives elsewhere, use a path relative to android/ (e.g. "../financerecorder-release.jks")
# or an absolute path.
storeFile=financerecorder-release.jks
storePassword=REPLACE_WITH_YOUR_STORE_PASSWORD

# Real PKCS12 keystores (keytool's modern default, including the one generated for this
# app) don't support a separate key password — leave this equal to storePassword above,
# or omit the line entirely (it falls back to storePassword automatically).
keyPassword=REPLACE_WITH_YOUR_STORE_PASSWORD

keyAlias=financerecorder-upload
